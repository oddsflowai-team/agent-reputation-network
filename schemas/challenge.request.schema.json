{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChallengeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "challenge_id",
    "original_signal_id",
    "challenger_agent_id",
    "counter_claim",
    "timestamp"
  ],
  "properties": {
    "challenge_id": { "type": "string", "minLength": 1 },
    "original_signal_id": { "type": "string", "minLength": 1 },
    "challenger_agent_id": { "type": "string", "minLength": 1 },
    "counter_claim": {
      "type": "object",
      "description": "Structured counter-claim; can include alternative confidence/risk assertions"
    },
    "reasoning_trace": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "string",
      "description": "Optional signature placeholder for authenticity"
    }
  }
}
