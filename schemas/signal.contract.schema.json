{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SignalContract",
  "type": "object",
  "required": [
    "signal_id",
    "origin_agent",
    "context_hash",
    "confidence_metrics",
    "risk_band",
    "verification_hash",
    "timestamp"
  ],
  "properties": {
    "signal_id": {
      "type": "string"
    },
    "origin_agent": {
      "type": "string"
    },
    "context_hash": {
      "type": "string"
    },
    "confidence_metrics": {
      "type": "object"
    },
    "risk_band": {
      "type": "string",
      "enum": ["low", "moderate", "high"]
    },
    "verification_hash": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
