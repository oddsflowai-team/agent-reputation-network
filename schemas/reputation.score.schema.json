{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReputationScore",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "protocol_version", "score", "tier", "as_of", "components"],
  "properties": {
    "agent_id": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": "string", "minLength": 1 },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "tier": { "type": "string", "enum": ["S", "A", "B", "C", "D"] },
    "as_of": { "type": "string", "format": "date-time" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["C", "T", "P", "V", "Q"],
      "properties": {
        "C": { "type": "number", "minimum": 0, "maximum": 1 },
        "T": { "type": "number", "minimum": 0, "maximum": 1 },
        "P": { "type": "number", "minimum": 0, "maximum": 1 },
        "V": { "type": "number", "minimum": 0, "maximum": 1 },
        "Q": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "notes": { "type": "string" },
    "input_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional references to logs used in scoring"
    }
  }
}
